{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,

    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": [],
    "modules-right": [
        "mpris",
        "pulseaudio",
        "custom/network",
        "cpu",
        "memory",
        "disk",
        "bluetooth",
        "custom/mic",
        "clock",
        "tray"
    ],

    // Modules configuration
            "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{value}"
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "mpris": {
        "format": "{player_icon}  {title} - {artist}",
        "format-paused": "{status_icon}  {title} - {artist}",
        "player-icons": {
            "default": "",
            "plasma-browser-integration": "",
            "spotify": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 40,
        "ignored-players": [],
        "on-click-middle": "playerctl play-pause"
    },

    "tray": {
        "spacing": 6
    },

    "clock": {
        "format": "  {:%a, %d %b <b>%H:%M</b>}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "  {usage} %",
        "tooltip": true,
        "interval": 3
    },

    "memory": {
        "format": "  {used:0.1f} G",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB\nSwap: {swapUsed:0.1f}GiB / {swapTotal:0.1f}GiB"
    },

    "disk": {
        "interval": 30,
        "format": "  {free}",
        "path": "/home",
        "tooltip": true,
        "tooltip-format": "Available: {free} / {total}"
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network-bandwidth.sh",
        "return-type": "json",
        "interval": 2,
        "format": "{}",
        "markup": true
    },

    "pulseaudio": {
        "format": "{icon}  {volume} %",
        "format-muted": "  {volume} %",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{desc}: {volume}%"
    },

    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-on": "",
        "format-connected": "  {device_alias}",
        "format-connected-battery": "  {device_alias} ({device_battery_percentage}%)",
        "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
        "on-click": "rfkill toggle bluetooth",
        "on-click-right": "blueman-manager"
    },

    "custom/mic": {
        "exec": "~/.config/waybar/scripts/mic-status.sh",
        "return-type": "json",
        "interval": 1,
        "signal": 8,
        "format": "{}",
        "on-click": "pactl set-source-mute alsa_input.usb-Focusrite_Scarlett_2i4_USB-00.HiFi__Mic1__source toggle && pkill -RTMIN+8 waybar",
        "tooltip": false
    }
}
