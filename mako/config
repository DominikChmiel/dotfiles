# Mako notification daemon configuration
# Wayland-native replacement for dunst

# Positioning and sizing
anchor=top-right
margin=20
width=450
height=150

# Appearance
font=Source Sans Pro 10
background-color=#212121
text-color=#F3F4F5
border-color=#2B83A6
border-size=2
border-radius=0
padding=12
margin=10

# Behavior
default-timeout=10000
ignore-timeout=0
max-visible=5
layer=overlay
sort=-time

# Icons
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=48
icons=1

# Group notifications by app
group-by=app-name

# Format
format=<b>%s</b>\n%b
markup=1

# Urgency levels - these override the defaults above
[urgency=low]
background-color=#212121
text-color=#86888C
border-color=#585858
default-timeout=5000

[urgency=normal]
background-color=#212121
text-color=#F3F4F5
border-color=#2B83A6
default-timeout=10000

[urgency=critical]
background-color=#4B0202
text-color=#CB2933
border-color=#D64E4E
border-size=3
default-timeout=0
ignore-timeout=1

# App-specific rules
[app-name="Microsoft Teams"]
background-color=#212121
text-color=#F3F4F5
border-color=#6264A7
default-timeout=15000

[app-name="Chromium"]
border-color=#4285F4

[category=email]
default-timeout=20000
