# Wayland session profile
# This should be loaded before starting Sway

# Set Wayland environment
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sway

# Qt applications
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# Use the installed KDE platform-theme plugin (qt5ct is not installed here);
# this makes KDE apps read ~/.config/kdeglobals. Kept in sync with .bashrc-wayland.
export QT_QPA_PLATFORMTHEME=kde

# Firefox/Mozilla
export MOZ_ENABLE_WAYLAND=1
export MOZ_DBUS_REMOTE=1

# Electron apps
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# SDL
export SDL_VIDEODRIVER=wayland

# Java
export _JAVA_AWT_WM_NONREPARENTING=1

# Clutter
export CLUTTER_BACKEND=wayland

# Start Sway if not already running and on tty1
# Note: --unsupported-gpu flag required for Nvidia proprietary drivers
if [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" -eq 1 ]; then
    exec sway --unsupported-gpu
fi
