# Sway config file
#
# Read `man 5 sway` for a complete reference.

# ================= Environment Variables =================

# For screen sharing to work properly
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

# ================= Startup applications =================

# Notification daemon (mako is Wayland-native, but dunst also works)
exec --no-startup-id mako
# Alternative: exec --no-startup-id dunst

# Network manager applet (runs via XWayland)
exec --no-startup-id nm-applet

# Wallpaper - use swaybg or set in output config
# TODO: Set your wallpaper path here
# exec swaybg -i /path/to/wallpaper.jpg -m fill
# Or use output command below

# Idle management (optional)
# exec swayidle -w \
#     timeout 300 'swaylock -f' \
#     timeout 600 'swaymsg "output * dpms off"' \
#     resume 'swaymsg "output * dpms on"' \
#     before-sleep 'swaylock -f'

# ================= Display/Output Configuration =================
#
# Multi-monitor setup:
# - DP-1 (Dell P2720D): Left, portrait mode, 2560x1440@60Hz
# - DP-2 (MSI MPG 274URF QD): Center, 4K@120Hz with 1.5x scaling
# - HDMI-A-1 (Dell S2721DGF): Right, 2560x1440@120Hz
#
# Note: Positions are auto-arranged by wdisplays, adjust if needed

# Left monitor - Portrait orientation
output DP-1 {
    mode 2560x1440@60Hz
    pos 1197 883
    transform 270
    scale 1.0
    bg /home/aiconomix/Wallpapers/Minimalistic2.jpg fill
}

# Center monitor - 4K with scaling
output DP-2 {
    mode 3840x2160@120Hz
    pos 2637 984
    scale 1.5
    bg /home/aiconomix/Wallpapers/Minimalistic2.jpg fill
}

# Right monitor
output HDMI-A-1 {
    mode 2560x1440@120Hz
    pos 5196 984
    scale 1.0
    bg /home/aiconomix/Wallpapers/Minimalistic2.jpg fill
}

# ================= Fonts/Colors =================

font pango:Source Sans Pro, Font Awesome 10

# config colors
# class                 border  backgr. text    indicator child_border
client.focused          #2B83A6 #2B83A6 #FFFFFF #DDDDDD   #2B83A6
client.focused_inactive #212121 #212121 #86888C #292D2E   #212121
client.unfocused        #212121 #212121 #86888C #292D2E   #212121
client.urgent           #2F343A #D64E4E #FFFFFF #D64E4E   #D64E4E
client.placeholder      #212121 #0C0C0C #FFFFFF #212121   #212121
client.background       #212121

# ================= Variables =================

set $mod Mod4+Mod1+Shift+Ctrl
set $meh Mod1+Shift+Ctrl

set $mic alsa_input.usb-Focusrite_Scarlett_2i4_USB-00.HiFi__Mic1__source

# ================= Keybinds =================

# Media keys
# Pulse Audio controls (PulseAudio/PipeWire)
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +2%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -2%
bindsym XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle

# Screen brightness controls (using brightnessctl)
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# Media player controls
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPause exec playerctl pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

bindsym XF86HomePage exec chromium --enable-features=UseOzonePlatform --ozone-platform=wayland

# Application launcher (rofi with Wayland support)
bindsym $mod+o exec "rofi -combi-modi run,window -show combi -modi combi -theme android_notification -sort -sorting-method fzf -matching fuzzy"

# Microphone mute toggle (send signal to waybar for instant update)
bindsym $mod+m exec pactl set-source-mute $mic toggle && pkill -RTMIN+8 waybar

# Use Mouse+Mod4 (Super) to drag floating windows
# Note: floating_modifier only accepts single modifiers, not combinations
floating_modifier Mod4 normal

# Start a terminal (foot is fastest Wayland terminal)
set $term foot
bindsym $mod+space exec $term
bindsym $mod+t exec $term

# File explorer
bindsym $mod+e exec dolphin

# Remove border
bindsym $mod+u border none

# Change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# Alternatively, cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window
bindsym $meh+j move left
bindsym $meh+k move down
bindsym $meh+l move up
bindsym $meh+semicolon move right

# Alternatively, cursor keys:
bindsym $meh+Left move left
bindsym $meh+Down move down
bindsym $meh+Up move up
bindsym $meh+Right move right

# Allow moving to different outputs
bindsym $meh+u move workspace to output right
bindsym $meh+p move workspace to output left

# Split in horizontal orientation
bindsym $mod+h split h

# Split in vertical orientation
bindsym $mod+v split v

# Enter fullscreen mode for the focused container
bindsym $mod+f fullscreen

# Change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+q layout toggle split

# Kill focused window
bindsym $meh+q kill

# Change focus between tiling / floating windows
bindsym $meh+Return focus mode_toggle

# Toggle tiling / floating
bindsym $meh+space floating toggle

# Focus the parent container
bindsym $mod+a focus parent

# Focus the child container
#bindsym $mod+d focus child

# Screenshot using grim + slurp + satty (Wayland-native flameshot alternative)
# Print: capture selection and open in satty for annotation/save/copy
bindsym Print exec grim -g "$(slurp)" - | satty --filename - --fullscreen --output-filename ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
# Ctrl+Print: capture full screen and open in satty
bindsym Ctrl+Print exec grim - | satty --filename - --fullscreen --output-filename ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# Reload configuration
bindsym $mod+c reload

# Exit sway (logs you out of your Wayland session)
# bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -b 'Yes' 'swaymsg exit'

# Notification dismiss
bindsym Ctrl+space exec makoctl dismiss
# Alternative for dunst: bindsym Ctrl+space exec dunstctl close

# ================= Workspace setups =================

# Customize workspace name
set $WS1   "1:   Chromium"
set $WS2   "2:   Chromium"
set $WS3   "3:   Code"
set $WS4   "4:   Code"
set $WS5   "5:   Bash"
set $WS6   "6:   General"
set $WS7   "7:   General"
set $WS8   "8:   Teams"
set $WS9   "9:   General"
set $WS0   "10:   Mail"

# Workspace to output assignments
# DP-2 (center 4K): Main workspaces for Chromium, Code, Mail
# HDMI-A-1 (right): Secondary Chromium, Code, General
# DP-1 (left portrait): Bash, Teams
workspace $WS1 output DP-2
workspace $WS2 output HDMI-A-1
workspace $WS3 output DP-2
workspace $WS4 output HDMI-A-1
workspace $WS5 output DP-1
workspace $WS6 output HDMI-A-1
workspace $WS7 output DP-1
workspace $WS8 output DP-1
workspace $WS0 output DP-2

# Default to vertical split for portrait monitor workspaces
workspace $WS5 layout splitv
workspace $WS7 layout splitv
workspace $WS8 layout splitv

# Switch to workspace
bindsym $mod+1 workspace $WS1
bindsym $mod+2 workspace $WS2
bindsym $mod+3 workspace $WS3
bindsym $mod+4 workspace $WS4
bindsym $mod+5 workspace $WS5
bindsym $mod+6 workspace $WS6
bindsym $mod+7 workspace $WS7
bindsym $mod+8 workspace $WS8
bindsym $mod+9 workspace $WS9
bindsym $mod+0 workspace $WS0

# Move focused container to workspace
bindsym $meh+1 move container to workspace $WS1
bindsym $meh+2 move container to workspace $WS2
bindsym $meh+3 move container to workspace $WS3
bindsym $meh+4 move container to workspace $WS4
bindsym $meh+5 move container to workspace $WS5
bindsym $meh+6 move container to workspace $WS6
bindsym $meh+7 move container to workspace $WS7
bindsym $meh+8 move container to workspace $WS8
bindsym $meh+9 move container to workspace $WS9
bindsym $meh+0 move container to workspace $WS0

# ================= Alternate modes setups =================

# Resize window mode
mode "  " {
        # These bindings trigger as soon as you enter the resize mode
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym odiaeresis resize grow width 10 px or 10 ppt

        # Same bindings, but for the arrow keys
        bindsym Left resize grow width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize shrink width 10 px or 10 ppt

        # Back to normal: Enter or Escape
        bindsym Return mode "default"
        bindsym Escape mode "default"
}

bindsym $meh+r mode "  "

# ================= Bar setups =================
#
# Using Waybar (Wayland-native status bar)
# Configuration: ~/.config/waybar/config
# Styling: ~/.config/waybar/style.css

bar {
    swaybar_command waybar
}

# ================= Windowing setups =================
# Window rules for floating windows

for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="plugin_ui"] floating enable
for_window [title="Preferences$"] floating enable
for_window [title="Menu Update"] floating enable
for_window [title="___"] floating enable
for_window [instance="Download"] floating enable

for_window [app_id="pavucontrol"] floating enable
for_window [app_id="mpv"] floating enable
for_window [app_id="com.gabm.satty"] fullscreen enable
for_window [class="SimpleScreenRecorder"] floating enable
for_window [class="Pavucontrol"] floating enable
for_window [class="mpv"] floating enable; move absolute position 640px 764px

# Workspace assignments
for_window [class="automaited-native"] move container to workspace $WS9
for_window [class="chromium (aiConomix)"] move container to workspace $WS9
for_window [class="Microsoft Teams"] move container to workspace $WS8
for_window [class="firefox"] move container to workspace $WS7
for_window [title="Microsoft Teams Notification"] floating enable
for_window [title="Microsoft Teams-Benachrichtigung"] floating enable

# Disable floating for certain applications
for_window [app_id="org.kde.dolphin"] floating disable
for_window [class="dolphin"] floating disable

# Default border
for_window [class="^.*"] border pixel 2
for_window [app_id="^.*"] border pixel 2

# Matlab scratchpad window
for_window [title="HG_Peer_OffScreenWindow"] move scratchpad

# ================= Additional Sway config =================

# Set popups during fullscreen mode
popup_during_fullscreen smart

# Focus follows mouse
focus_follows_mouse no

# Window borders
default_border pixel 0
default_floating_border normal 0
hide_edge_borders none

# Title bar padding (horizontal vertical)
titlebar_padding 5 2

# Gaps
smart_borders on
smart_gaps on
gaps inner 8
gaps outer 2

# Enable XWayland for X11 app compatibility
xwayland enable

# ================= Input Configuration =================
#
# Keyboard configuration for US International (allows German umlauts on US keyboard)
input type:keyboard {
    xkb_layout us
    xkb_variant altgr-intl
}
